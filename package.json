{
  "name": "serverless-orders-api",
  "version": "1.0.0",
  "description": "Serverless REST API for managing customer orders on AWS (API Gateway, Lambda, DynamoDB, ElastiCache) deployed with AWS SAM.",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "sam build",
    "validate": "sam validate --lint",
    "deploy": "sam build && sam deploy",
    "deploy:guided": "sam build && sam deploy --guided",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --coverage",
    "local:up": "docker compose up -d",
    "local:down": "docker compose down",
    "local:table": "tsx scripts/create-local-table.ts",
    "local:api": "sam build && sam local start-api --env-vars env.local.json --docker-network orders-local",
    "smoke": "tsx scripts/smoke-test.ts"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.36.0",
    "@aws-lambda-powertools/metrics": "^2.36.0",
    "@aws-sdk/client-dynamodb": "^3.1151.0",
    "@aws-sdk/lib-dynamodb": "^3.1151.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "ioredis": "^5.11.1",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  }
}
